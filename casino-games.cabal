cabal-version:      3.0
name:               casino-games
version:            0.1.0.0
build-type:         Simple

executable roulette-app
    main-is:          Main.hs
    hs-source-dirs:   app, src
    default-language: Haskell2010
    ghc-options:      -Wall
    other-modules:
        Roulette.Logic
        Roulette.Types
        Roulette.UI
    build-depends:
        base >=4.14 && <5,
        gloss >=1.13,
        random >=1.2
